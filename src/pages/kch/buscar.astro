---
import Layout from '../../layouts/Layout.astro';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';

const t = useTranslations('kch');
const resultsUrl = getLocalizedPath('/resultados', 'kch');
---

<Layout title="Tzukuj · TODOMIGOB">
  <!-- Vista 2: Búsqueda (K'iche') -->
  <section class="flex-1 flex flex-col items-center justify-center min-h-[60vh] px-4 py-8 max-w-xl mx-auto w-full text-center">
    <h1 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-white max-w-md mx-auto mb-6 leading-tight">
      {t('search.instruction')}
    </h1>

    <form action={resultsUrl} method="GET" class="w-full max-w-md flex flex-col items-center gap-5">
      <div class="w-full">
        <input
          type="text"
          name="q"
          placeholder={t('search.placeholder')}
          required
          autofocus
          class="w-full px-4 py-3 border-2 border-[#4997D0] rounded-xl text-base text-neutral-900 dark:text-white placeholder:text-neutral-400 dark:placeholder:text-neutral-500 focus:outline-none focus:ring-2 focus:ring-[#4997D0] bg-white dark:bg-[#202020] shadow-xs"
        />
      </div>

      <button
        type="submit"
        class="w-36 sm:w-44 py-2.5 px-6 bg-[#4997D0] hover:bg-sky-600 text-white font-bold text-lg rounded-xl transition-colors cursor-pointer shadow-md active:translate-y-0.5"
      >
        {t('search.button')}
      </button>
    </form>
  </section>
</Layout>
